# Copy to .env.prod and fill in real values before running the prod stack:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_USER=locara
POSTGRES_PASSWORD=change-me
POSTGRES_DB=locara_ssh

JWT_SECRET=change-me-to-a-long-random-string
VAULT_MASTER_KEY=change-me-to-a-32-byte-base64-key

# Public origin the app is served from (used for CORS; same-origin via nginx otherwise).
WEB_ORIGIN=http://localhost

# Host port nginx listens on.
WEB_PORT=80
