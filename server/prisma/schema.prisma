generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum AuthType {
  PASSWORD
  PRIVATE_KEY
  AGENT
}

enum CredentialType {
  PASSWORD
  PRIVATE_KEY
  PASSPHRASE
}

enum KubeCredentialType {
  KUBECONFIG
}

enum DbEngine {
  MYSQL
  POSTGRES
}

enum DbCredentialType {
  PASSWORD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  ownedTeams   Team[]        @relation("TeamOwner")
  memberships  TeamMember[]
  hosts        Host[]        @relation("HostOwnerUser")
  kubeClusters KubeCluster[] @relation("KubeClusterOwnerUser")
  dbConnections DbConnection[] @relation("DbConnectionOwnerUser")
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Team {
  id      String @id @default(cuid())
  name    String
  ownerId String
  owner   User   @relation("TeamOwner", fields: [ownerId], references: [id])

  members      TeamMember[]
  hosts        Host[]        @relation("HostOwnerTeam")
  kubeClusters KubeCluster[] @relation("KubeClusterOwnerTeam")
  dbConnections DbConnection[] @relation("DbConnectionOwnerTeam")

  createdAt DateTime @default(now())
}

model TeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  role   TeamRole @default(MEMBER)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

model Host {
  id            String   @id @default(cuid())
  ownerUserId   String?
  ownerTeamId   String?
  ownerUser     User?    @relation("HostOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerTeam     Team?    @relation("HostOwnerTeam", fields: [ownerTeamId], references: [id], onDelete: Cascade)

  name          String
  hostname      String
  port          Int      @default(22)
  username      String
  authType      AuthType @default(PASSWORD)
  tags          String[] @default([])
  folder        String?
  color         String?
  lastConnectedAt DateTime?

  credentials Credential[]
  tunnelingDbConnections DbConnection[] @relation("DbConnectionTunnelHost")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([ownerTeamId])
}

model Credential {
  id         String         @id @default(cuid())
  hostId     String
  host       Host           @relation(fields: [hostId], references: [id], onDelete: Cascade)
  type       CredentialType
  ciphertext String
  iv         String
  authTag    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
}

model KubeCluster {
  id          String   @id @default(cuid())
  ownerUserId String?
  ownerTeamId String?
  ownerUser   User?    @relation("KubeClusterOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerTeam   Team?    @relation("KubeClusterOwnerTeam", fields: [ownerTeamId], references: [id], onDelete: Cascade)

  name             String
  defaultNamespace String?
  tags             String[]  @default([])
  folder           String?
  color            String?
  lastConnectedAt  DateTime?

  credential KubeCredential?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([ownerTeamId])
}

model KubeCredential {
  id            String             @id @default(cuid())
  kubeClusterId String             @unique
  kubeCluster   KubeCluster        @relation(fields: [kubeClusterId], references: [id], onDelete: Cascade)
  type          KubeCredentialType @default(KUBECONFIG)
  ciphertext    String
  iv            String
  authTag       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DbConnection {
  id          String   @id @default(cuid())
  ownerUserId String?
  ownerTeamId String?
  ownerUser   User?    @relation("DbConnectionOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerTeam   Team?    @relation("DbConnectionOwnerTeam", fields: [ownerTeamId], references: [id], onDelete: Cascade)

  name     String
  engine   DbEngine
  hostname String
  port     Int
  database String
  username String

  tunnelHostId String?
  tunnelHost   Host?   @relation("DbConnectionTunnelHost", fields: [tunnelHostId], references: [id], onDelete: SetNull)

  tags            String[]  @default([])
  folder          String?
  color           String?
  lastConnectedAt DateTime?

  credential DbCredential?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([ownerTeamId])
  @@index([tunnelHostId])
}

model DbCredential {
  id             String           @id @default(cuid())
  dbConnectionId String           @unique
  dbConnection   DbConnection     @relation(fields: [dbConnectionId], references: [id], onDelete: Cascade)
  type           DbCredentialType @default(PASSWORD)
  ciphertext     String
  iv             String
  authTag        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
